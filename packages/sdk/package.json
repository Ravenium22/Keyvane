{
  "name": "@keyvane/sdk",
  "version": "0.1.0",
  "description": "Official JavaScript/TypeScript SDK for Keyvane — licenses, entitlements and usage limits for indie software.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "licensing",
    "license-keys",
    "entitlements",
    "feature-flags",
    "usage-limits",
    "subscriptions",
    "stripe",
    "saas",
    "indie-hackers"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ravenium22/Keyvane.git",
    "directory": "packages/sdk"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "node --disable-warning=ExperimentalWarning --test --test-reporter=spec \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
