# Copy to .env for docker compose. See docs/self-hosting.md for every option.
NODE_ENV=production
KEYVANE_PUBLIC_URL=https://keyvane.example.com
# At least 32 random characters. Keep it stable and backed up.
KEYVANE_SECRET=
TRUST_PROXY=true
SIGNUPS_ENABLED=true

# Password-reset emails (optional; without it reset links are written to the log)
# RESEND_API_KEY=
# MAIL_FROM=Keyvane <no-reply@example.com>

# KEYVANE_CONTACT_EMAIL=hello@example.com

# Operator dashboard at /app/admin
# KEYVANE_ADMIN_EMAILS=you@example.com

# Bill your own users with Keyvane (see docs/self-hosting.md)
# KEYVANE_BILLING_PROJECT=
# KEYVANE_UPGRADE_LINKS=indie=https://buy.stripe.com/...,startup=https://buy.stripe.com/...
# KEYVANE_BILLING_PORTAL_URL=
# KEYVANE_ENFORCE_PLAN_LIMITS=false

# Cookieless analytics on public pages
# KEYVANE_PLAUSIBLE_DOMAIN=keyvane.example.com
